{
  "name": "tala-engine",
  "version": "0.1.84",
  "description": "Tala Cognitive Engine Room — local AI orchestration shell",
  "main": "electron/main.js",
  "author": "Tala Project",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "web": "node scripts/start-web-ui.js",
    "test": "jest",
    "test:js": "jest --runInBand",
    "lint": "eslint . && node scripts/run_venv_python.js -m ruff check python sdk scripts tests conftest.py",
    "lint:js": "eslint .",
    "lint:py": "node scripts/run_venv_python.js -m ruff check python sdk scripts tests conftest.py",
    "test:py": "node scripts/run_venv_python.js -m pytest tests --ignore=tests/benchmarks -q",
    "self-test": "node scripts/run_venv_python.js scripts/tala_self_test.py",
    "rebuild": "electron-rebuild"
  },
  "dependencies": {
    "electron-store": "^10.0.0",
    "ws": "^8.18.0",
    "xterm": "^5.3.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "electron": "^42.3.3",
    "eslint": "^10.10.0",
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js",
      "**/?(*.)+(spec|test).js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.claude/",
      "/.tala_snapshots/",
      "/scratch/",
      "/blockchain/"
    ]
  }
}
