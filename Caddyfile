talacore.app {
	# The harness peer WebSocket (8765). TLS terminates here; the socket
	# itself is meant to bind loopback (see scripts/start-tala-vps.sh), so
	# handshake HMACs and relayed payloads never cross the internet in
	# cleartext. Peers dial wss://talacore.app/ws.
	handle /ws {
		reverse_proxy 127.0.0.1:8765
	}

	# The chain node (blockchain/src/app.js).
	handle /chain/* {
		reverse_proxy 127.0.0.1:8332
	}

	# Everything else — the site, version.json and the release zips — is
	# static. scripts/upload_vps.ps1 publishes releases here (AND to
	# /opt/tala/blockchain/public, which the node app reads itself).
	# This mirrors what production has actually served since 2026-09-06;
	# the pre-2026-09-23 version of this file routed everything to the
	# node app and was never deployed, which hid the divergence — and the
	# missing /ws route — for weeks.
	handle {
		root * /var/www/talacore
		file_server
	}
}
