# Dependencies
node_modules/
.venv/

# Python caches and test state
__pycache__/
*.py[cod]
.pytest_cache/

# Local environment
.env

# Tala generated/runtime state
.tala_snapshots/
data/*.db
data/*.sqlite
data/*.sqlite3
data/chroma/
data/pytest_temp/
blockchain/data/*.json
blockchain/data/admin_secret.txt
# Neural nodes ARE the data, not build output — they are Tala's memory,
# persona, documentation and learned knowledge, and most of them exist in
# exactly one place on disk. Ignoring them is what turned the 2026-08-11
# rollback bug from "a bad night" into permanent loss: ~58 nodes had no copy
# in git, in the snapshot, or in the AppData install, and are simply gone.
# The whole directory is 614K. It is tracked.
#
# The exception is settings-*: those are regenerated deterministically from
# the database on every startup (settings_nn.sync_settings_to_nodes), so
# tracking them is pure churn — 13 rewritten files per launch.
nodes/settings-*.html
nodes/settings-*_lora/
# Probation areas for newly authored nodes: transient by definition. A node
# is tracked once it earns promotion into nodes/ (see sdk/agent/node_staging.py).
nodes/_staging/
nodes/_quarantine/
nodes/*.html.bak
nodes/_archive_legacy/
nodes/.wizard_state.json
nodes/.workflow_state.json

# Keep placeholder files
!data/.gitkeep
!blockchain/data/.gitkeep
!nodes/.gitkeep

# Logs and temporary files
*.log
*.tmp
*.bak

# Build and scratch directories
dist/
scratch/

# Runtime state written into the user-data root (which defaults to the install
# directory for USB portability), not source.
emotion_state.json
mcp_servers.json

# Per-user runtime state: which chat mode is active. Machine-local, not shared.
chat_mode.json
