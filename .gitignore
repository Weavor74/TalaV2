# Dependencies
node_modules/
.venv/

# Python caches and test state
__pycache__/
*.py[cod]
.pytest_cache/

# Local environment
.env

# Tala generated/runtime state
.tala_snapshots/
# Downloaded llama.cpp engine binaries -- fetched on demand by
# python/inference/llama_server_manager.py, never committed (a compiled
# native binary is not source, and this is exactly the "not vendored" design
# decision behind BINARIES_MANIFEST_URL).
/engines/
data/*.db
data/*.sqlite
data/*.sqlite3
data/chroma/
data/pytest_temp/
blockchain/data/*.json
blockchain/data/admin_secret.txt
# Neural nodes ARE the data, not build output — they are Tala's memory,
# persona, documentation and learned knowledge, and most of them exist in
# exactly one place on disk. Ignoring them is what turned the 2026-08-11
# rollback bug from "a bad night" into permanent loss: ~58 nodes had no copy
# in git, in the snapshot, or in the AppData install, and are simply gone.
# The whole directory is 614K. It is tracked.
#
# The exception is settings-*: those are regenerated deterministically from
# the database on every startup (settings_nn.sync_settings_to_nodes), so
# tracking them is pure churn — 13 rewritten files per launch.
nodes/settings-*.html
nodes/settings-*_lora/
# Probation areas for newly authored nodes: transient by definition. A node
# is tracked once it earns promotion into nodes/ (see sdk/agent/node_staging.py).
#
# TEMPORARY (2026-09-17): nodes/_staging/ is un-ignored so the ECC SKILL.md
# imports have a copy in git while they sit on probation. They exist in exactly
# one place on disk otherwise, which is the condition that made the 2026-08-11
# rollback permanent. Restore the line below once they promote into nodes/,
# and `git rm --cached -r nodes/_staging` at the same time.
# nodes/_staging/
# ...but not its ledger: passes/dwell counters, rewritten every cycle. Same
# churn argument as settings-* above.
nodes/_staging/.promotion_ledger.json
nodes/_quarantine/
nodes/*.html.bak
nodes/_archive_legacy/
nodes/.wizard_state.json
nodes/.workflow_state.json

# Keep placeholder files
!data/.gitkeep
!blockchain/data/.gitkeep
!nodes/.gitkeep

# Logs and temporary files
*.log
*.tmp
*.bak

# Build and scratch directories
dist/
scratch/

# Runtime state written into the user-data root (which defaults to the install
# directory for USB portability), not source.
emotion_state.json
mcp_servers.json

# Per-user runtime state: which chat mode is active. Machine-local, not shared.
chat_mode.json

# Corrupted-database backups taken before a rebuild. Machine-local salvage,
# not source: data/chroma/ itself is already ignored.
data/chroma.corrupted-backup-*/

# setuptools build metadata, regenerated by every editable install.
# Tracked until 2026-08-23, which made six files show as modified after any
# pip install and put build output into every diff.
*.egg-info/

# Generated training corpus. The stories are produced by the corpus generator,
# not authored, so new batches should not land in diffs. 242 files were already
# tracked when this rule was added on 2026-08-23 and stay tracked -- .gitignore
# only affects untracked paths. Run `git rm -r --cached data/training_corpus/`
# if those should be dropped from version control too.
data/training_corpus/

# Runtime halt state. Machine-local: a halt engaged on one machine
# must not travel to another via the repository.
data/emergency_halt.json

# Claude Code session data (worktrees, local settings)
.claude/
data/workstation.json
