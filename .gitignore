# Dependencies
node_modules/
.venv/

# Python caches and test state
__pycache__/
*.py[cod]
.pytest_cache/

# Local environment
.env

# Tala generated/runtime state
.tala_snapshots/
data/*.db
data/*.sqlite
data/*.sqlite3
data/chroma/
data/pytest_temp/
blockchain/data/*.json
blockchain/data/admin_secret.txt
nodes/*.html
# The self-extension workflow node is part of the engine contract (the DAG
# chain's source of truth, with the built-in chain as fallback) — tracked
# like the other canonical nodes.
!nodes/workflow-self-extension.html
nodes/*.html.bak
nodes/_archive_legacy/
nodes/.wizard_state.json
nodes/.workflow_state.json

# Keep placeholder files
!data/.gitkeep
!blockchain/data/.gitkeep
!nodes/.gitkeep

# Logs and temporary files
*.log
*.tmp
*.bak

# Build and scratch directories
dist/
scratch/

# Runtime state written into the user-data root (which defaults to the install
# directory for USB portability), not source.
emotion_state.json
mcp_servers.json
